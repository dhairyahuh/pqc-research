# ==============================================================================
# ASTRA-Sec: Environment Configuration Template (.env.example)
#
# Copy this file to .env and customize the parameters for your local node instance.
# DO NOT COMMIT REAL SECRETS OR SENSITIVE OPERATIONAL KEYS TO REPOSITORIES.
# ==============================================================================

# Node Identity and Network Addressing (RFC 9171 DTN Endpoint ID)
# Format: dtn://<node-name> or ipn:<node-number>.<service-number>
ASTRA_NODE_EID=dtn://node-a.space.net

# Operational Role: ground_station, satellite_relay, satellite_payload, mission_control
ASTRA_NODE_ROLE=ground_station

# Host and Network Ports
ASTRA_BIND_HOST=127.0.0.1
ASTRA_BIND_PORT=8080

# Logging Configuration: DEBUG, INFO, WARNING, ERROR, CRITICAL
ASTRA_LOG_LEVEL=INFO

# Storage Spool Directory for Bundles and Persistent Audit Logs
ASTRA_SPOOL_DIR=/tmp/astra_sec/spool

# Delay-Tolerant Network Parameters
# Maximum tolerated disruption delay before timeout escalation (seconds)
ASTRA_MAX_DISRUPTION_TIMEOUT_SEC=86400

# Path to Compiled C Fault-Resilient Cryptographic Engine Binary
ASTRA_C_ENGINE_BIN=./bin/test_fips_kats

# Cryptographic Key Paths (Placeholders for Phase 04 / Phase 05)
# ASTRA_SIGNING_KEY_PATH=/etc/astra-sec/keys/signing_key.pem
# ASTRA_ENC_KEY_PATH=/etc/astra-sec/keys/enc_key.pem
