# ==============================================================================
# ASTRA-Sec: Complete Environment Configuration Template (.env.example)
#
# Copy this file to .env and customize the parameters for your local node instance.
# DO NOT COMMIT REAL SECRETS OR SENSITIVE OPERATIONAL KEYS TO REPOSITORIES.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Node Identity & Role Configuration
# ------------------------------------------------------------------------------
# Unique DTN Endpoint Identifier (RFC 9171 URI format)
# Required: No | Default: dtn://gsa/app
ASTRA_NODE_EID=dtn://gsa/app

# Operational Protocol Role: originator, relay, destination
# Required: No | Default: originator
ASTRA_NODE_ROLE=originator

# ------------------------------------------------------------------------------
# 2. Network & Binding Configuration
# ------------------------------------------------------------------------------
# Network IP interface to bind services
# Required: No | Default: 127.0.0.1
ASTRA_LISTEN_HOST=127.0.0.1

# Inbound DTN Bundle Protocol transport port
# Required: No | Default: 4556
ASTRA_LISTEN_PORT=4556

# Auxiliary HTTP health diagnostic service port
# Required: No | Default: 8080
ASTRA_HEALTH_PORT=8080

# Comma-separated peer DTN endpoints for routing table discovery
# Required: No | Default: empty (relies on static routing table)
ASTRA_PEER_ENDPOINTS=http://127.0.0.1:4557,http://127.0.0.1:4558

# ------------------------------------------------------------------------------
# 3. Storage & Spool Configuration
# ------------------------------------------------------------------------------
# Persistent storage directory for SQLite WAL bundle queues and telemetry
# Required: No | Default: ./data/spool
ASTRA_SPOOL_DIR=./data/spool

# Default bundle Time-To-Live in seconds (e.g., 86400 = 24 hours)
# Required: No | Default: 86400
ASTRA_BUNDLE_TTL=86400

# Double Ratchet symmetric key renewal frequency (in number of bundles)
# Required: No | Default: 100
ASTRA_RATCHET_INTERVAL=100

# ------------------------------------------------------------------------------
# 4. Cryptographic Native Engine Paths
# ------------------------------------------------------------------------------
# Path override for native C monitored cryptographic engine shared library
# Optional | Default: auto-detected in ./bin/libastra_crypto.{dylib,so}
ASTRA_CRYPTO_LIB_PATH=./bin/libastra_crypto.dylib

# Path override for system liboqs shared library (if using liboqs fallback engine)
# Optional | Default: auto-detected in standard system paths (/opt/homebrew/lib, /usr/local/lib)
# LIBOQS_PATH=/opt/homebrew/lib/liboqs.dylib

# ------------------------------------------------------------------------------
# 5. Mission Control Dashboard & Telemetry
# ------------------------------------------------------------------------------
# Secret administrative bearer token for dispatching messages via REST/WebSocket
# Required: No | Default: astra-mission-control-token
ASTRA_ADMIN_TOKEN=astra-mission-control-token

# Logging verbosity level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Required: No | Default: INFO
ASTRA_LOG_LEVEL=INFO

# Emit structured JSON log records (recommended for production observability)
# Required: No | Default: false
ASTRA_JSON_LOGS=false
