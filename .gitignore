# ==============================================================================
# ASTRA-Sec: Git Ignore Rules
# ==============================================================================

# Compiled Native Binaries & Shared Libraries
bin/
*.o
*.dylib
*.a
*.so

# Python Cache & Package Artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual Environments
.venv/
venv/
env/
ENV/

# Local Environment Variables, Credentials & Secret Keys
.env
.env.local
.env.*.local
*.pem
*.key

# SQLite Temporary Transaction Journals
*.db-wal
*.db-shm
*.db-journal

# Operating System & IDE Metadata
.DS_Store
Thumbs.db
.vscode/
.idea/

